{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkey",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "TALKEY_APPS",
      "service": "talkey-para-talkey-subpaths"
    }
  ],
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMITER",
      "namespace_id": "2847301",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "DEMO_GLOBAL_RATE_LIMITER",
      "namespace_id": "2847302",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "CF_AI_MODEL": "@cf/openai/gpt-oss-20b",
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "talkeyco.com",
      "custom_domain": true
    },
    {
      "pattern": "www.talkeyco.com",
      "custom_domain": true
    }
  ]
}
